rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Existing user data — owner only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public profiles — anyone authenticated can read, only owner writes
    match /userProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Market listings — authenticated read, Cloud Functions write only
    match /marketListings/{listingId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Community prayer requests — authenticated read, owner can create, Functions update
    match /prayerRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                     && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Prayer subcollection for tracking who prayed
    match /prayerRequests/{requestId}/prayers/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Community events — authenticated read, Cloud Functions manage
    match /communityEvents/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Social Layer ──

    // Follows — authenticated read, Cloud Functions write
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Posts — authenticated read, owner create, Cloud Functions update (counters)
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                     && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Post likes — authenticated read, Cloud Functions write
    match /posts/{postId}/likes/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Post comments — authenticated read, owner create
    match /posts/{postId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                     && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Porch Blog ──
    // Anyone (even signed-out visitors) may READ published posts.
    // Only the site OWNER may create / edit / delete.
    // Gated by the owner's verified Google email (keep in sync with
    // BLOG_OWNER_EMAIL in src/constants.js). After editing, redeploy:
    //   firebase deploy --only firestore:rules
    function isBlogOwner() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && request.auth.token.email.lower() == 'heathereaton7@gmail.com';
    }
    match /blogPosts/{postId} {
      allow read: if resource.data.status == 'published' || isBlogOwner();
      allow create: if isBlogOwner()
                     && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isBlogOwner();
    }

    // ── Mailing list ──
    // Each signed-in user owns their own subscriber doc (id == uid) and may
    // create/update it (name, email, marketing consent). Only the site owner
    // may read the full list (for CSV export). No one may delete.
    match /subscribers/{userId} {
      allow read:           if isBlogOwner();
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete:         if false;
    }

    // Notifications — recipient can read + mark as read, authenticated can create
    match /notifications/{notificationId} {
      allow read: if request.auth != null
                   && resource.data.recipientId == request.auth.uid;
      allow update: if request.auth != null
                     && resource.data.recipientId == request.auth.uid
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if request.auth != null;
      allow delete: if false;
    }

    // ── Upper Room Gatherings ──

    // Gathering posts — authenticated read, author creates, author + mod updates
    match /upperRoomPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                     && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Gathering replies — authenticated read, author creates
    match /upperRoomReplies/{replyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                     && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Gathering reactions — authenticated read/write (one per user per post)
    match /upperRoomReactions/{reactionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Gathering reports — authenticated create, no public read
    match /upperRoomReports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
